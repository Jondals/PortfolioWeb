---
import { Image } from "astro:assets";
import Icon from "./icon.astro";
import profile from "../assets/images/profile.webp";
import { projects } from "../data/projects.ts";
import { games } from "../data/games.ts";

// Tamaños de la foto: los usa también el layout para precargarla
export const profileImage = {
  widths: [160, 224, 256, 288, 448, 576],
  sizes: "(min-width: 1280px) 288px, (min-width: 768px) 256px, (min-width: 640px) 224px, 160px",
};

const socials = [
  { href: "https://github.com/Jondals", icon: "GitHub", label: "GitHub" },
  { href: "https://www.linkedin.com/in/jonathandoradoquintero/", icon: "LinkedIn", label: "LinkedIn" },
  { href: "mailto:jondals@proton.me", icon: "Email", label: "Email" },
];

const stats = [
  { value: "3+", en: "Years coding", es: "Años programando" },
  { value: `${projects.length + games.length}`, en: "Projects built", es: "Proyectos desarrollados" },
  { value: "2", en: "Company internships", es: "Prácticas en empresa" },
  { value: "DAM", en: "Higher Degree in Multi-platform Development", es: "Grado Superior en Desarrollo Multiplataforma" },
];
---

<!-- Inicio y "Sobre mí" en una sola sección: texto a la izquierda, foto y datos a la derecha -->
<section id="about" class="relative px-5 sm:px-6 pt-24 md:pt-32 pb-16 md:pb-24 lg:min-h-svh lg:flex lg:items-center">
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-x-16 gap-y-10 items-center">

    <div class="order-2 lg:order-1">
        <h1 class="text-[2rem] leading-[1.1] sm:text-5xl lg:text-[3.25rem] xl:text-6xl font-bold sm:leading-[1.08] tracking-tight text-balance">
          <span
            class="block bg-linear-to-r from-cyan-400 via-blue-400 to-purple-500 bg-clip-text text-transparent pb-1"
            data-en="Full Stack Developer"
            data-es="Desarrollador Full Stack"
          >
            Full Stack Developer
          </span>
          <span
            class="block text-(--text-primary)"
            data-en="& Game Developer"
            data-es="y de Videojuegos"
          >
            & Game Developer
          </span>
        </h1>

        <p class="mt-5 md:mt-6 text-base md:text-xl text-(--text-secondary) leading-relaxed max-w-2xl"
          data-en="I design and build modern web, mobile applications, focused on performance, scalability, and user experience. From full-stack platforms and collaborative systems to mobile applications, multiplayer experiences, and developer tools."
          data-es="Diseño y desarrollo aplicaciones web, móviles, centradas en rendimiento, escalabilidad y experiencia de usuario. Desde plataformas full stack y sistemas colaborativos hasta aplicaciones móviles, experiencias multijugador y herramientas para desarrolladores.">
          I design and build modern web, mobile applications, focused on performance, scalability, and user experience. From full-stack platforms and collaborative systems to mobile applications, multiplayer experiences, and developer tools.
        </p>

        <p class="mt-4 text-sm md:text-base text-(--text-secondary) leading-relaxed max-w-2xl"
          data-en="I started programming about 3 years ago with Java while studying a Multi-Platform Application Development degree. Since then I have kept learning on my own and today I focus on scalable web platforms, multiplayer systems and developer tools."
          data-es="Empecé a programar hace unos 3 años con Java mientras estudiaba el Grado Superior de Desarrollo de Aplicaciones Multiplataforma. Desde entonces sigo aprendiendo por mi cuenta y hoy me centro en plataformas web escalables, sistemas multijugador y herramientas para desarrolladores.">
          I started programming about 3 years ago with Java while studying a Multi-Platform Application Development degree. Since then I have kept learning on my own and today I focus on scalable web platforms, multiplayer systems and developer tools.
        </p>

        <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-3 md:gap-4">
          <a href="#projects"
            class="group inline-flex items-center gap-2 px-5 py-3 md:px-7 md:py-3.5 rounded-[10px] bg-(--accent) text-black text-sm md:text-base font-semibold hover:-translate-y-0.5 hover:shadow-xl hover:shadow-(--accent)/30 shadow-lg shadow-(--accent)/20">
            <span data-en="View Work" data-es="Ver Trabajo">View Work</span>
            <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition duration-300" />
          </a>

          <a href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-5 py-3 md:px-7 md:py-3.5 rounded-[10px] bg-(--bg-secondary) border border-(--text-primary)/10 text-(--text-primary) text-sm md:text-base hover:bg-(--bg-card) hover:border-(--accent)/40 hover:-translate-y-0.5">
            <Icon name="download" class="w-4 h-4 group-hover:translate-y-0.5 transition duration-300" />
            <span data-en="Download CV" data-es="Descargar CV">Download CV</span>
          </a>

          <div class="flex items-center gap-2 md:gap-3">
            {socials.map((social) => (
              <a href={social.href}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="p-3 md:p-3.5 rounded-[10px] bg-(--bg-secondary) border border-(--text-primary)/10 text-(--text-primary) hover:bg-(--bg-card) hover:border-(--accent)/40 hover:-translate-y-0.5"
                aria-label={social.label}>
                <Icon name={social.icon} class="w-[18px] h-[18px] md:w-5 md:h-5" />
              </a>
            ))}
          </div>
        </div>
    </div>

    <div class="order-1 lg:order-2 flex flex-col gap-6">
      <div class="order-1 lg:order-none flex justify-center">
        <div class="relative">
          <div class="absolute -inset-6 bg-linear-to-tr from-cyan-500/25 via-purple-500/25 to-blue-500/25 blur-3xl rounded-full"></div>
          <div class="relative w-40 h-40 sm:w-56 sm:h-56 md:w-64 md:h-64 xl:w-72 xl:h-72 rounded-full overflow-hidden border border-(--text-primary)/10 shadow-2xl shadow-black/40">
            <Image
              src={profile}
              alt="Jonathan Dorado"
              widths={profileImage.widths}
              sizes={profileImage.sizes}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>

      <ul class="hidden lg:grid grid-cols-2 gap-3 md:gap-4">
        {stats.map((stat) => (
          <li class="flex flex-col justify-between gap-3 min-h-28 md:min-h-36 p-4 md:p-6 rounded-[12px] border border-(--text-primary)/10 bg-(--bg-secondary) hover:border-(--accent)/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10 transition duration-500 ease-out">
            <span class="text-3xl md:text-5xl font-bold tracking-tight bg-linear-to-r from-cyan-400 via-blue-400 to-purple-500 bg-clip-text text-transparent">
              {stat.value}
            </span>
            <span class="text-xs md:text-sm text-(--text-secondary) leading-snug" data-en={stat.en} data-es={stat.es}>
              {stat.en}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <ul class="order-3 lg:hidden grid grid-cols-2 gap-3">
        {stats.map((stat) => (
          <li class="flex flex-col justify-between gap-3 min-h-28 md:min-h-36 p-4 md:p-6 rounded-[12px] border border-(--text-primary)/10 bg-(--bg-secondary) hover:border-(--accent)/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10 transition duration-500 ease-out">
            <span class="text-3xl md:text-5xl font-bold tracking-tight bg-linear-to-r from-cyan-400 via-blue-400 to-purple-500 bg-clip-text text-transparent">
              {stat.value}
            </span>
            <span class="text-xs md:text-sm text-(--text-secondary) leading-snug" data-en={stat.en} data-es={stat.es}>
              {stat.en}
            </span>
          </li>
        ))}
    </ul>
  </div>
</section>
