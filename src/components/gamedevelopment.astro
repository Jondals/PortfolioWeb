---
import Sectionheading from "./sectionheading.astro";
import Projectcard from "./projectcard.astro";
import { games } from "../data/games.ts";
---

<section id="game-development" class="relative px-5 sm:px-6 pt-12 md:pt-16 pb-16 md:pb-24">

  <div class="max-w-7xl mx-auto">

    <Sectionheading
      title={{ en: "Game Development", es: "Desarrollo de videojuegos" }}
      subtitle={{
        en: "Game prototypes focused on gameplay programming, multiplayer systems, and interactive mechanics built with Unity.",
        es: "Prototipos de videojuegos enfocados en programación de gameplay, sistemas multijugador y mecánicas interactivas con Unity.",
      }}
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-8">
      {games.map((game, index) => (
        <Projectcard
          {...game}
          reveal={index}
          contributionLabel={{ en: "Focus:", es: "Enfoque:" }}
          imageClass="h-64"
        />
      ))}
    </div>
  </div>
</section>
