---
import type { Translation } from "../data/projects.ts";

interface Props {
  title: Translation;
  subtitle?: Translation;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-10 md:mb-14" data-reveal>
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
    <span data-en={title.en} data-es={title.es}>{title.en}</span><span class="text-(--accent-text)">.</span>
  </h2>

  {subtitle && (
    <p
      class="mt-4 max-w-3xl text-(--text-secondary) text-base md:text-lg leading-relaxed text-balance"
      data-en={subtitle.en}
      data-es={subtitle.es}
    >
      {subtitle.en}
    </p>
  )}
</div>
