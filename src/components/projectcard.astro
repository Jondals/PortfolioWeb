---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./icon.astro";
import Techlist from "./techlist.astro";
import Statusbadge from "./statusbadge.astro";
import type { Translation } from "../data/projects.ts";

interface Props {
  title: string;
  status: Translation;
  description: Translation;
  contribution: Translation;
  contributionLabel?: Translation;
  tech: string[];
  image: ImageMetadata;
  github: string;
  demo?: string | null;
  imageClass?: string;
  /** Versión reducida: sin la línea de rol/enfoque */
  compact?: boolean;
  /** Posición para escalonar la animación de entrada */
  reveal?: number;
}

const {
  title,
  status,
  description,
  contribution,
  contributionLabel = { en: "Role:", es: "Rol:" },
  tech,
  image,
  github,
  demo,
  imageClass = "h-48",
  compact = false,
  reveal,
} = Astro.props;
---

<article data-reveal={reveal !== undefined ? "" : undefined} style={reveal !== undefined ? `--i:${reveal}` : undefined} class="group flex flex-col rounded-[12px] overflow-hidden bg-(--bg-secondary) border border-(--text-primary)/10 shadow-lg hover:shadow-2xl hover:shadow-black/20 hover:-translate-y-1.5 hover:border-(--accent)/40 transition duration-500 ease-out">

  <div class={`${imageClass} overflow-hidden relative`}>
    <Image
      src={image}
      alt={`${title} screenshot`}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition duration-700 ease-out"
    />

    <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

    <Statusbadge status={status} variant="overlay" class="absolute top-3 right-3" />
  </div>

  <div class="p-4 md:p-5 flex flex-col gap-3 flex-1">

    <h3 class="text-lg font-bold text-(--text-primary) group-hover:text-(--accent-text) transition duration-300">
      {title}
    </h3>

    <p
      class="text-sm text-(--text-secondary) leading-relaxed"
      data-en={description.en}
      data-es={description.es}
    >
      {description.en}
    </p>

    {!compact && (
      <p class="text-xs text-(--text-secondary)">
        <span class="text-(--text-primary) font-semibold" data-en={contributionLabel.en} data-es={contributionLabel.es}>
          {contributionLabel.en}
        </span>{" "}
        <span
          data-en={contribution.en}
          data-es={contribution.es}
        >
          {contribution.en}
        </span>
      </p>
    )}

    <div class="mt-auto pt-2 flex flex-col gap-4">
      <Techlist tech={tech} />

      <div class="flex items-center gap-3">
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[10px] border border-(--text-primary)/10 bg-(--bg-card) text-(--text-primary) text-sm hover:bg-(--bg-hover) hover:border-(--accent)/40 hover:-translate-y-0.5"
          aria-label={`${title} GitHub`}
        >
          <Icon name="GitHub" class="w-4 h-4" />
          GitHub
        </a>

        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-[10px] border border-(--text-primary)/10 bg-(--bg-card) text-(--text-primary) text-sm hover:bg-(--bg-hover) hover:border-(--accent)/40 hover:-translate-y-0.5"
          >
            <Icon name="external" class="w-4 h-4" />
            <span data-en="Visit site" data-es="Ver web">Visit site</span>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
