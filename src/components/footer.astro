---
import Icon from "./icon.astro";

const year = new Date().getFullYear();

const contacts = [
  {
    href: "mailto:jondals@proton.me",
    icon: "Email",
    label: { en: "Email", es: "Email" },
    value: { en: "jondals@proton.me", es: "jondals@proton.me" },
    external: false,
  },
  {
    href: "/cv.pdf",
    icon: "download",
    label: { en: "Résumé", es: "Currículum" },
    value: { en: "Download CV", es: "Descargar CV" },
    external: true,
  },
];

const card = "rounded-[12px] border border-(--text-primary)/10 bg-(--bg-secondary)";
---

<footer id="contact" class="relative px-5 sm:px-6 pt-8 md:pt-12 pb-8">
  <div class="max-w-7xl mx-auto">

    <div class="grid lg:grid-cols-[1.6fr_1fr] gap-3 md:gap-4" data-reveal>
      <div class={`${card} p-6 md:p-10 flex flex-col justify-center gap-5`}>

        <div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-[1.1]">
            <span data-en="Let's build something together" data-es="¿Construimos algo juntos?">Let's build something together</span>
          </h2>
          <p
            class="mt-4 max-w-xl text-base md:text-lg text-(--text-secondary) leading-relaxed"
            data-en="I'm open to full-time roles, internships and freelance projects. Send me a message and I'll get back to you soon."
            data-es="Estoy abierto a ofertas a jornada completa, prácticas y proyectos freelance. Escríbeme y te responderé lo antes posible."
          >
            I'm open to full-time roles, internships and freelance projects. Send me a message and I'll get back to you soon.
          </p>
        </div>
      </div>

      <ul class="grid gap-3 md:gap-4">
        {contacts.map((contact) => (
          <li>
            <a
              href={contact.href}
              target={contact.external ? "_blank" : undefined}
              rel={contact.external ? "noopener noreferrer" : undefined}
              class={`group h-full flex items-center gap-4 p-5 md:p-6 ${card} hover:border-(--accent)/40 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10`}
            >
              <span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[10px] bg-(--accent)/10 text-(--accent-text)">
                <Icon name={contact.icon} class="w-[18px] h-[18px]" />
              </span>
              <span class="flex-1 min-w-0 flex flex-col gap-0.5">
                <span class="text-xs text-(--text-secondary)" data-en={contact.label.en} data-es={contact.label.es}>
                  {contact.label.en}
                </span>
                <span class="text-base md:text-lg font-semibold text-(--text-primary) truncate" data-en={contact.value.en} data-es={contact.value.es}>
                  {contact.value.en}
                </span>
              </span>
              <Icon name="arrow-right" class="w-5 h-5 shrink-0 text-(--text-secondary) -rotate-45 group-hover:rotate-0 group-hover:text-(--accent-text) transition duration-500 ease-out" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs md:text-sm text-(--text-secondary)">
      <span>
        © {year} Jondals. <span data-en="All rights reserved." data-es="Todos los derechos reservados.">All rights reserved.</span>
      </span>

      <span class="flex items-center gap-2">
        <span data-en="Built with" data-es="Hecho con">Built with</span>
        <span class="inline-flex items-center gap-1.5 text-(--text-primary)">
          <Icon name="Astro" class="w-4 h-4" /> Astro
        </span>
        <span data-en="and" data-es="y">and</span>
        <span class="inline-flex items-center gap-1.5 text-(--text-primary)">
          <Icon name="Tailwind CSS" class="w-4 h-4" /> Tailwind CSS
        </span>
      </span>
    </div>
  </div>
</footer>
