---
import { svgs } from "../data/svgs.ts";
---

<footer
  class="relative mt-24 px-6 py-16 border-t border-white/5 overflow-hidden"
  style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);"
>

  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-indigo-500/[0.08] to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-start">

      <div class="space-y-4 text-center md:text-left">

        <h3 class="text-lg font-semibold text-white">
          Jonathan Dorado
        </h3>

        <p class="text-sm text-white/60 leading-relaxed max-w-sm">
          <span
            data-en="Full Stack Developer focused on building scalable systems, and interactive experiences."
            data-es="Desarrollador Full Stack enfocado en construir sistemas escalables y experiencias interactivas."
          ></span>
        </p>

        <div class="flex flex-wrap justify-center md:justify-start gap-3 text-xs text-white/50">
          <a href="#projects" class="hover:text-white transition">
            <span data-en="Projects" data-es="Proyectos"></span>
          </a>
          <a href="#about" class="hover:text-white transition">
            <span data-en="About me" data-es="Sobre mí"></span>
          </a>
          <a href="mailto:jondals@proton.me" class="hover:text-white transition">
            <span data-en="Contact" data-es="Contacto"></span>
          </a>
        </div>

      </div>

      <div class="flex justify-center items-center">
        <div class="relative"></div>
      </div>

      <div class="flex justify-center md:justify-end">

        <div class="flex md:flex-col gap-3">

          <a href="https://github.com/Jondals"
            target="_blank"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition hover:-translate-y-1"
            aria-label="GitHub">
            <img src={svgs.GitHub} class="w-5 h-5 opacity-70 hover:opacity-100 transition" />
          </a>

          <a href="https://linkedin.com/in/jonathandoradoquintero/"
            target="_blank"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition hover:-translate-y-1"
            aria-label="LinkedIn">
            <img src={svgs.LinkedIn} class="w-5 h-5 opacity-70 hover:opacity-100 transition" />
          </a>

          <a href="mailto:jondals@proton.me"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition hover:-translate-y-1"
            aria-label="Email">
            <img src={svgs.Email} class="w-5 h-5 opacity-70 hover:opacity-100 transition" />
          </a>

          <!--<a href=""
            target="_blank"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition hover:-translate-y-1"
            aria-label="LinkedIn">
            <img src={svgs.InfoJobs} class="w-5 h-5 opacity-70 hover:opacity-100 transition" />
          </a>-->

        </div>
      </div>
    </div>

    <div class="mt-14 border-t border-white/5 pt-6 flex flex-col md:flex-row items-center justify-between gap-3">

      <p class="text-xs text-white/40">
        <span data-en="© 2026 All rights reserved." data-es="© 2026 Todos los derechos reservados."></span>
      </p>

      <p class="text-xs text-white/40">
        <span data-en="Built with Astro and Tailwind CSS" data-es="Construido con Astro y Tailwind CSS"></span>
      </p>

    </div>
  </div>
</footer>