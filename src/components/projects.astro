---

<section id="projects" class="min-h-screen px-6 py-20 scroll-mt-15">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-5xl font-bold mt-4"
        data-en="Projects"
        data-es="Proyectos"
      >
      </h2>

      <p
        class="text-(--text-secondary) mt-4 max-w-2xl mx-auto"
        data-en="A collection of real-world applications built with different technologies, focused on learning, scalability and user experience."
        data-es="Una colección de aplicaciones reales desarrolladas con distintas tecnologías, enfocadas en aprendizaje, escalabilidad y experiencia de usuario."
      >
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      {images.map((project) => (
        <article class="group relative rounded-2xl overflow-hidden bg-white/5 border border-white/10 backdrop-blur-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">

          <div class="h-48 overflow-hidden relative">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
            />

            <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

            <span
              class="absolute top-3 right-3 text-[10px] px-3 py-1 rounded-full bg-black/40 border border-white/20 text-white backdrop-blur"
              data-en={project.status.en}
              data-es={project.status.es}
            >
              {project.status.en}
            </span>
          </div>

          <div class="p-5 flex flex-col gap-3">

            <h3 class="text-lg font-bold text-white group-hover:text-(--accent) transition">
              {project.title}
            </h3>

            <p
              class="text-sm text-(--text-secondary) leading-relaxed"
              data-en={project.description.en}
              data-es={project.description.es}
            >
              {project.description.en}
            </p>

            <p class="text-xs text-(--text-secondary)">
              <span class="text-white font-semibold" data-en="Role:" data-es="Rol:">
                Role:
              </span>{" "}
              <span
                data-en={project.contribution.en}
                data-es={project.contribution.es}
              >
                {project.contribution.en}
              </span>
            </p>

            <div class="flex flex-wrap gap-2 mt-3">
              {project.tech.map((t) => (
                <span class="flex items-center gap-2 text-[11px] px-3 py-1 rounded-full bg-white/5 border border-white/10 hover:bg-white/10 hover:scale-105 transition">
                  {svgs[t] && (<img src={svgs[t]} class="w-3.5 h-3.5" />)}
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-3 mt-4">

              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-(--accent)/10 border border-(--accent)/20 text-(--accent) hover:bg-(--accent)/20 transition"
              >
                GitHub
              </a>

              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition"
                  aria-label="Live Demo"
                >
                  👁
                </a>
              )}

            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>