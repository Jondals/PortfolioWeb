---
import { Image } from "astro:assets";
import Icon from "./icon.astro";
import Techlist from "./techlist.astro";
import Projectcard from "./projectcard.astro";
import { projects } from "../data/projects.ts";

const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<section id="projects" class="px-6 py-24 scroll-mt-20">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <h2
        class="text-4xl md:text-5xl font-bold"
        data-en="Projects"
        data-es="Proyectos"
      >
        Projects
      </h2>

      <p
        class="text-(--text-secondary) mt-4 max-w-2xl mx-auto"
        data-en="A collection of real-world applications built with different technologies, focused on learning, scalability and user experience."
        data-es="Una colección de aplicaciones reales desarrolladas con distintas tecnologías, enfocadas en aprendizaje, escalabilidad y experiencia de usuario."
      >
        A collection of real-world applications built with different technologies, focused on learning, scalability and user experience.
      </p>
    </div>

    <div
      class="carousel relative"
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured projects"
    >
      <div class="carousel-track no-scrollbar flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-3xl" tabindex="0">
        {featured.map((project, index) => (
          <article
            class="carousel-slide group w-full shrink-0 snap-center grid lg:grid-cols-[1.3fr_1fr] rounded-3xl overflow-hidden bg-(--text-primary)/3 border border-(--text-primary)/10"
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} / ${featured.length}`}
          >
            <div class="relative aspect-video lg:aspect-auto lg:h-full lg:min-h-105 overflow-hidden">
              <Image
                src={project.image}
                alt={`${project.title} screenshot`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1280px) 720px, (min-width: 1024px) 56vw, 100vw"
                loading={index === 0 ? "eager" : "lazy"}
                class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-105 transition duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></div>
            </div>

            <div class="p-6 sm:p-10 flex flex-col gap-4">
              <div class="flex flex-wrap items-center gap-3">
                <span
                  class="text-[10px] uppercase tracking-widest px-3 py-1 rounded-full border border-(--accent)/40 text-(--accent-text)"
                  data-en="Featured"
                  data-es="Destacado"
                >
                  Featured
                </span>
                <span
                  class="text-[10px] uppercase tracking-widest px-3 py-1 rounded-full border border-(--text-primary)/15 text-(--text-secondary)"
                  data-en={project.status.en}
                  data-es={project.status.es}
                >
                  {project.status.en}
                </span>
              </div>

              <h3 class="text-3xl md:text-4xl font-bold text-(--text-primary)">
                {project.title}
              </h3>

              <p
                class="text-(--text-secondary) leading-relaxed"
                data-en={project.description.en}
                data-es={project.description.es}
              >
                {project.description.en}
              </p>

              <p class="text-sm text-(--text-secondary)">
                <span class="text-(--text-primary) font-semibold" data-en="Role:" data-es="Rol:">
                  Role:
                </span>{" "}
                <span
                  data-en={project.contribution.en}
                  data-es={project.contribution.es}
                >
                  {project.contribution.en}
                </span>
              </p>

              <Techlist tech={project.tech} />

              <div class="flex flex-wrap items-center gap-3 mt-auto pt-4">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-(--accent)/10 border border-(--accent)/20 text-(--accent-text) hover:bg-(--accent)/20"
                  aria-label={`${project.title} GitHub`}
                >
                  <Icon name="GitHub" class="w-4 h-4" />
                  GitHub
                </a>

                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-(--accent) text-black font-semibold hover:scale-[1.03] shadow-lg shadow-(--accent)/20"
                  >
                    <Icon name="external" class="w-4 h-4" />
                    <span data-en="Live demo" data-es="Ver demo">Live demo</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-6 flex items-center justify-center gap-4">
        <button
          type="button"
          class="carousel-prev w-11 h-11 rounded-full flex items-center justify-center border border-(--text-primary)/15 text-(--text-primary) hover:bg-(--text-primary)/10 hover:-translate-x-0.5"
          aria-label="Previous project"
        >
          <Icon name="arrow-left" class="w-5 h-5" />
        </button>

        <div class="flex items-center gap-2">
          {featured.map((project, index) => (
            <button
              type="button"
              class="carousel-dot group/dot w-6 h-6 flex items-center justify-center"
              aria-label={`Go to ${project.title}`}
              aria-current={index === 0 ? "true" : "false"}
              data-index={index}
            >
              <span class="block h-2 w-2 rounded-full bg-(--text-primary)/25 transition-all duration-300 group-hover/dot:bg-(--text-primary)/50 group-aria-[current=true]/dot:w-6 group-aria-[current=true]/dot:bg-(--accent)"></span>
            </button>
          ))}
        </div>

        <button
          type="button"
          class="carousel-next w-11 h-11 rounded-full flex items-center justify-center border border-(--text-primary)/15 text-(--text-primary) hover:bg-(--text-primary)/10 hover:translate-x-0.5"
          aria-label="Next project"
        >
          <Icon name="arrow-right" class="w-5 h-5" />
        </button>
      </div>
    </div>

    <div class="mt-24">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-2 mb-10">
        <h3
          class="text-2xl md:text-3xl font-bold"
          data-en="More projects"
          data-es="Más proyectos"
        >
          More projects
        </h3>
        <p
          class="text-sm text-(--text-secondary)"
          data-en="Side projects, experiments and work in progress."
          data-es="Proyectos personales, experimentos y trabajo en curso."
        >
          Side projects, experiments and work in progress.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {others.map((project) => (
          <Projectcard {...project} />
        ))}
      </div>
    </div>
  </div>
</section>
