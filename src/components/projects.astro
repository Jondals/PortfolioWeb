---
import { Image } from "astro:assets";
import Icon from "./icon.astro";
import Sectionheading from "./sectionheading.astro";
import Projectcard from "./projectcard.astro";
import Featuredcarousel from "./featuredcarousel.astro";
import { projects } from "../data/projects.ts";

const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<section id="projects" class="relative px-5 sm:px-6 pt-12 md:pt-16 pb-16 md:pb-24">

  <div class="max-w-7xl mx-auto">
    <Sectionheading
      title={{ en: "Projects", es: "Proyectos" }}
      subtitle={{
        en: "A collection of real-world applications built with different technologies, focused on learning, scalability and user experience.",
        es: "Una colección de aplicaciones reales desarrolladas con distintas tecnologías, enfocadas en aprendizaje, escalabilidad y experiencia de usuario.",
      }}
    />

    <Featuredcarousel projects={featured} />

    <div class="more-projects mt-4" data-reveal style="--i:1">
      <!-- Barra integrada bajo el carrusel: miniaturas de los proyectos y botón para desplegarlos -->
      <button
        type="button"
        class="collapse-toggle group w-full flex items-center gap-4 md:gap-6 p-4 md:p-5 rounded-[12px] border border-(--text-primary)/10 bg-(--bg-secondary) text-left hover:border-(--accent)/40 hover:bg-(--bg-card)"
        aria-expanded="false"
        aria-controls="more-projects-list"
      >
        <span class="hidden sm:flex -space-x-3 shrink-0" aria-hidden="true">
          {others.map((project) => (
            <Image
              src={project.image}
              alt=""
              width={96}
              height={96}
              class="w-11 h-11 rounded-[10px] object-cover border-2 border-(--bg-secondary) group-hover:border-(--bg-card) transition-colors duration-500"
            />
          ))}
        </span>

        <span class="flex-1 min-w-0">
          <span class="block text-base md:text-lg font-semibold text-(--text-primary)" data-en="More projects" data-es="Más proyectos">More projects</span>
          <span
            class="block text-xs md:text-sm text-(--text-secondary) truncate"
            data-en="Side projects, experiments and work in progress."
            data-es="Proyectos personales, experimentos y trabajo en curso."
          >
            Side projects, experiments and work in progress.
          </span>
        </span>

        <span class="shrink-0 inline-flex items-center gap-2 text-sm font-medium text-(--text-primary)">
          <span class="collapse-label hidden sm:inline" data-en={`Show ${others.length}`} data-es={`Ver ${others.length}`}>Show {others.length}</span>
          <span class="w-8 h-8 flex items-center justify-center rounded-[8px] bg-(--accent)/15 text-(--accent-text) group-hover:bg-(--accent) group-hover:text-black transition-colors duration-500">
            <Icon name="arrow-down" class="collapse-icon w-4 h-4 transition-transform duration-500 ease-out" />
          </span>
        </span>
      </button>

      <div
        id="more-projects-list"
        class="collapse-panel grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
        inert
      >
        <div class="overflow-hidden">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 pt-3 md:pt-4 pb-2">
            {others.map((project, index) => (
              <Projectcard {...project} compact reveal={index} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
