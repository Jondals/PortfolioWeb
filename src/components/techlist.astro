---
import Icon from "./icon.astro";
import { techLinks } from "../data/tech.ts";

interface Props {
  tech: string[];
}

const { tech } = Astro.props;
---

<ul class="flex flex-wrap gap-1.5">
  {tech.map((t) => (
    <li>
      <a
        href={techLinks[t]}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-medium pl-1.5 pr-2.5 py-1 rounded-md bg-(--text-primary)/6 text-(--text-secondary) hover:bg-(--accent)/15 hover:text-(--text-primary)"
      >
        <Icon name={t} class="w-3.5 h-3.5" />
        {t}
      </a>
    </li>
  ))}
</ul>
