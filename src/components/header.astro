---
const navItems = [
  { href: "#hero", en: "Home", es: "Inicio" },
  { href: "#about", en: "About", es: "Sobre mí" },
  { href: "#projects", en: "Full Stack Projects", es: "Proyectos Full Stack" },
  { href: "#game-development", en: "Game Dev", es: "Desarrollo de Juegos" },
  { href: "#experience", en: "Experience", es: "Experiencia" },
  { href: "#skills", en: "Skills", es: "Habilidades" },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0f172a]/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center h-16 w-full">
      <a href="#hero" class="flex items-center">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-white/20 shadow-md">
          <img src="/icons/logo_header.svg" class="w-full h-full object-cover" />
        </div>
      </a>

      <nav class="hidden md:flex flex-1 justify-center">
        <ul class="flex items-center gap-10">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-300 hover:text-cyan-400 transition-colors whitespace-nowrap"
                data-en={item.en}
                data-es={item.es}
                >
                {item.en}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-3 ml-auto">

        <button
          id="theme-toggle"
          class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center"
          >
          <img id="theme-icon" src="/icons/moon.svg" class="w-5 h-5" />
        </button>

        <select
          id="language-select"
          class="hidden sm:block bg-slate-800 text-gray-200 border border-slate-700 rounded-lg px-3 py-1.5 text-sm"
          >
          <option value="es">🇪🇸 ES</option>
          <option value="en">🇬🇧 EN</option>
        </select>

        <button
          id="menu-btn"
          class="md:hidden w-10 h-10 flex items-center justify-center bg-slate-800 rounded-lg text-white text-xl"
          >
          ☰
        </button>

      </div>
    </div>
  </div>

  <div
    id="overlay"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-40"
  ></div>

  <div
    id="mobile-menu"
    class="fixed top-0 right-0 h-screen w-80 bg-[#0f172a]/95 backdrop-blur-xl border-l border-white/10 shadow-2xl
    transform translate-x-full transition-transform duration-300 z-50"
  >
    <div class="h-full flex flex-col p-6">

      <div class="flex justify-between items-center mb-10">
        <span class="text-gray-200 font-semibold">Menu</span>
        <button id="close-menu" class="text-white text-2xl">×</button>
      </div>

      <nav class="flex-1">
        <ul class="flex flex-col gap-6">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-300 hover:text-cyan-400 text-lg block"
              >
                {item.en}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="pt-6 border-t border-white/10">
        <select
          id="mobile-language-select"
          class="w-full bg-slate-800 text-gray-200 border border-slate-700 rounded-lg px-3 py-2 text-sm"
        >
          <option value="es">🇪🇸 ES</option>
          <option value="en">🇬🇧 EN</option>
        </select>
      </div>
    </div>
  </div>
</header>

<script type="module" src="/src/scripts/mobilemenu.ts"></script>
<script type="module" src="/src/scripts/language.ts"></script>
<script type="module" src="/src/scripts/themeToggle.ts"></script>