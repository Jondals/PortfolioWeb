---
/**
 * header.astro
 * Site header: logo, section navigation, the language toggle (desktop) and the mobile menu (which also holds the language toggle and the CV download).
 * It is transparent at the top of the page and gets a blurred background when scrolling (see global.css).
 */
import Icon from "./icon.astro";

const navItems = [
  { href: "#about", en: "About", es: "Sobre mí" },
  { href: "#projects", en: "Projects", es: "Proyectos" },
  { href: "#game-development", en: "Games", es: "Juegos" },
  { href: "#experience", en: "Experience", es: "Experiencia" },
  { href: "#skills", en: "Skills", es: "Habilidades" },
  { href: "#contact", en: "Contact", es: "Contacto" },
];

// Header buttons: fade smoothly on hover and sink slightly when pressed
const control =
  "group/ctl relative h-9 inline-flex items-center justify-center rounded-[8px] border border-(--text-primary)/10 bg-(--text-primary)/4 text-(--text-secondary) " +
  "hover:text-(--text-primary) hover:border-(--accent)/45 hover:bg-(--accent)/10 hover:shadow-[0_0_18px_-4px] hover:shadow-(--accent)/40 active:scale-95 " +
  "transition-[color,background-color,border-color,box-shadow,scale] duration-500 ease-out";
---

<header class="site-header fixed top-0 inset-x-0 z-50 px-5 sm:px-6">
  <div class="max-w-7xl mx-auto h-16 grid grid-cols-[1fr_auto_1fr] items-center gap-6">
    <a href="#about" class="justify-self-start group" aria-label="Jonathan Dorado, home">
      <Icon name="Logo" class="w-9 h-9 text-(--text-primary) group-hover:-rotate-6 group-hover:scale-105 transition duration-500 ease-out" />
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative block px-3.5 py-2 rounded-[8px] text-sm text-(--text-secondary) whitespace-nowrap
              hover:text-(--text-primary) hover:bg-(--text-primary)/5 aria-[current=true]:text-(--text-primary)
              transition-[color,background-color] duration-500 ease-out
              after:absolute after:left-3.5 after:right-3.5 after:bottom-0.5 after:h-0.5 after:rounded-full after:bg-linear-to-r after:from-cyan-400 after:to-purple-400
              after:origin-center after:scale-x-0 after:opacity-0 after:transition-[scale,opacity] after:duration-500 after:ease-out
              hover:after:scale-x-50 hover:after:opacity-60 aria-[current=true]:after:scale-x-100 aria-[current=true]:after:opacity-100"
              data-en={item.en}
              data-es={item.es}
              >
              {item.en}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-start-3 justify-self-end flex items-center gap-2">
      <button
        type="button"
        class={`lang-toggle hidden lg:inline-flex gap-2 px-3 text-xs font-semibold ${control}`}
        aria-label="Cambiar a español"
      >
        <span class="lang-flags flex items-center">
          <Icon name="flag-en" class="lang-flag-en w-5 h-[14px] rounded-[2px]" />
          <Icon name="flag-es" class="lang-flag-es w-5 h-[14px] rounded-[2px]" />
        </span>
        <span data-en="EN" data-es="ES">EN</span>
      </button>

      <button
        id="menu-btn"
        type="button"
        class={`lg:hidden w-9 ${control}`}
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="w-[18px] h-[18px]" />
      </button>
    </div>
  </div>
</header>

<div
  id="overlay"
  class="fixed inset-0 bg-black/70 z-60 opacity-0 pointer-events-none transition-opacity duration-500 ease-out"
></div>

<aside
  id="mobile-menu"
  class="fixed top-0 right-0 h-dvh w-80 max-w-[85vw] overflow-hidden bg-(--bg-secondary) border-l border-(--text-primary)/10 shadow-2xl
  transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] will-change-transform z-70"
  aria-label="Mobile menu"
  inert
>
  <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 rounded-full bg-linear-to-br from-cyan-500/20 via-purple-500/15 to-transparent blur-3xl"></div>

  <div class="relative h-full flex flex-col p-6">

    <div class="flex justify-between items-center mb-8">
      <span class="flex items-center gap-3">
        <Icon name="Logo" class="w-8 h-8 text-(--text-primary)" />
        <span class="text-(--text-primary) font-semibold" data-en="Menu" data-es="Menú">Menu</span>
      </span>
      <button
        id="close-menu"
        type="button"
        class="w-10 h-10 flex items-center justify-center rounded-[10px] text-(--text-primary) hover:bg-(--text-primary)/8 hover:rotate-90 transition duration-500"
        aria-label="Close menu"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    </div>

    <nav class="no-scrollbar flex-1 overflow-y-auto overflow-x-hidden" aria-label="Mobile">
      <ul class="flex flex-col">
        {navItems.map((item, i) => (
          <li style={`--i:${i}`} class="border-b border-(--text-primary)/8">
            <a
              href={item.href}
              class="nav-link group/link flex items-center gap-4 px-1 py-3.5 text-xl text-(--text-secondary) hover:text-(--text-primary) hover:translate-x-1 aria-[current=true]:text-(--text-primary)"
            >
              <span aria-hidden="true" class="w-6 text-xs tabular-nums text-(--text-muted) group-hover/link:text-(--accent-text) group-aria-[current=true]/link:text-(--accent-text)">0{i + 1}</span>
              <span class="flex-1" data-en={item.en} data-es={item.es}>{item.en}</span>
              <Icon name="arrow-right" class="w-4 h-4 opacity-0 -translate-x-2 group-hover/link:opacity-100 group-hover/link:translate-x-0 group-aria-[current=true]/link:opacity-100 group-aria-[current=true]/link:translate-x-0 text-(--accent-text) transition duration-500" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="menu-footer flex flex-col gap-4 pt-5" style={`--i:${navItems.length}`}>
      <div class="flex items-center gap-2.5">
        <a
          href="/cv-en.pdf"
          data-cv
          download="Jonathan-Dorado-CV-EN.pdf"
          class="flex-1 min-w-0 inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-[10px] bg-(--accent) text-black text-sm font-semibold whitespace-nowrap hover:opacity-90"
        >
          <Icon name="download" class="w-4 h-4 shrink-0" />
          <span data-en="Download CV" data-es="Descargar CV">Download CV</span>
        </a>

        <button
          type="button"
          class="lang-toggle shrink-0 inline-flex items-center justify-center gap-2 rounded-[10px] border border-(--text-primary)/10 bg-(--bg-card) text-(--text-primary) hover:bg-(--bg-hover) px-3 py-2.5 text-sm"
          aria-label="Cambiar a español"
        >
          <span class="lang-flags flex items-center">
            <Icon name="flag-en" class="lang-flag-en w-5 h-[14px] rounded-[2px]" />
            <Icon name="flag-es" class="lang-flag-es w-5 h-[14px] rounded-[2px]" />
          </span>
          <span data-en="EN" data-es="ES">EN</span>
        </button>
      </div>

      <div class="flex items-center justify-center gap-2">
        <a href="https://github.com/Jondals" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
          class="w-10 h-10 inline-flex items-center justify-center rounded-[10px] text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--text-primary)/8">
          <Icon name="GitHub" class="w-5 h-5" />
        </a>
        <a href="https://www.linkedin.com/in/jonathandoradoquintero/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
          class="w-10 h-10 inline-flex items-center justify-center rounded-[10px] text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--text-primary)/8">
          <Icon name="LinkedIn" class="w-5 h-5" />
        </a>
        <a href="mailto:jondals@proton.me" aria-label="Email"
          class="w-10 h-10 inline-flex items-center justify-center rounded-[10px] text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--text-primary)/8">
          <Icon name="Email" class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</aside>
