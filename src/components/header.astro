---
import Icon from "./icon.astro";

const navItems = [
  { href: "#about", en: "About", es: "Sobre mí" },
  { href: "#projects", en: "Projects", es: "Proyectos" },
  { href: "#game-development", en: "Games", es: "Juegos" },
  { href: "#experience", en: "Experience", es: "Experiencia" },
  { href: "#skills", en: "Skills", es: "Habilidades" },
  { href: "#contact", en: "Contact", es: "Contacto" },
];

// Botones del header: siguen el tema, con fundido suave al pasar el ratón y un pequeño hundimiento al pulsar
const control =
  "group/ctl relative h-9 inline-flex items-center justify-center rounded-[8px] border border-(--text-primary)/10 bg-(--text-primary)/4 text-(--text-secondary) " +
  "hover:text-(--text-primary) hover:border-(--accent)/45 hover:bg-(--accent)/10 hover:shadow-[0_0_18px_-4px] hover:shadow-(--accent)/40 active:scale-95 " +
  "transition-[color,background-color,border-color,box-shadow,scale] duration-500 ease-out";
---

<header class="site-header fixed top-0 inset-x-0 z-50 px-5 sm:px-6">
  <div class="max-w-7xl mx-auto h-16 grid grid-cols-[1fr_auto_1fr] items-center gap-6">
    <a href="#about" class="justify-self-start group" aria-label="Jonathan Dorado, home">
      <Icon name="Logo" class="w-9 h-9 text-(--text-primary) group-hover:-rotate-6 group-hover:scale-105 transition duration-500 ease-out" />
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative block px-3.5 py-2 rounded-[8px] text-sm text-(--text-secondary) whitespace-nowrap
              hover:text-(--text-primary) hover:bg-(--text-primary)/5 aria-[current=true]:text-(--text-primary)
              transition-[color,background-color] duration-500 ease-out
              after:absolute after:left-3.5 after:right-3.5 after:bottom-0.5 after:h-0.5 after:rounded-full after:bg-linear-to-r after:from-cyan-400 after:to-purple-400
              after:origin-center after:scale-x-0 after:opacity-0 after:transition-[scale,opacity] after:duration-500 after:ease-out
              hover:after:scale-x-50 hover:after:opacity-60 aria-[current=true]:after:scale-x-100 aria-[current=true]:after:opacity-100"
              data-en={item.en}
              data-es={item.es}
              >
              {item.en}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-start-3 justify-self-end flex items-center gap-2">
      <button id="theme-toggle" type="button" class={`${control} w-9`} aria-label="Toggle theme">
        <Icon name="sun" class="w-4 h-4 dark:hidden group-hover/ctl:rotate-45 transition-transform duration-700 ease-out" />
        <Icon name="moon" class="w-4 h-4 hidden dark:block group-hover/ctl:-rotate-12 transition-transform duration-700 ease-out" />
      </button>

      <button
        type="button"
        class={`lang-toggle hidden sm:inline-flex px-3 text-xs font-semibold ${control}`}
        data-en="🇬🇧 EN"
        data-es="🇪🇸 ES"
        aria-label="Cambiar a español"
      >
        🇬🇧 EN
      </button>

      <button
        id="menu-btn"
        type="button"
        class={`lg:hidden w-9 ${control}`}
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="w-[18px] h-[18px]" />
      </button>
    </div>
  </div>
</header>

<div
  id="overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-60 opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<aside
  id="mobile-menu"
  class="fixed top-0 right-0 h-dvh w-80 max-w-[85vw] bg-(--bg-secondary)/95 backdrop-blur-xl border-l border-(--text-primary)/10 shadow-2xl
  transform translate-x-full transition-transform duration-300 ease-out z-70"
  aria-label="Mobile menu"
  inert
>
  <div class="h-full flex flex-col p-6">

    <div class="flex justify-between items-center mb-10">
      <span class="text-(--text-primary) font-semibold" data-en="Menu" data-es="Menú">Menu</span>
      <button
        id="close-menu"
        type="button"
        class="w-10 h-10 flex items-center justify-center rounded-[10px] text-(--text-primary) hover:bg-(--text-primary)/8 hover:rotate-90 transition duration-500"
        aria-label="Close menu"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    </div>

    <nav class="flex-1" aria-label="Mobile">
      <ul class="flex flex-col gap-2">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link block px-3 py-2.5 rounded-[8px] text-(--text-secondary) text-lg hover:text-(--text-primary) hover:bg-(--text-primary)/5 hover:translate-x-1 aria-[current=true]:text-(--accent-text)"
              data-en={item.en}
              data-es={item.es}
            >
              {item.en}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex flex-col gap-3">
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full py-2.5 rounded-[10px] bg-(--accent) text-black text-sm font-semibold hover:opacity-90"
      >
        <Icon name="download" class="w-4 h-4" />
        <span data-en="Download CV" data-es="Descargar CV">Download CV</span>
      </a>

      <button
        type="button"
        class="lang-toggle w-full rounded-[10px] border border-(--text-primary)/10 bg-(--bg-card) text-(--text-primary) hover:bg-(--bg-hover) px-3 py-2.5 text-sm"
        data-en="🇬🇧 EN"
        data-es="🇪🇸 ES"
        aria-label="Cambiar a español"
      >
        🇬🇧 EN
      </button>
    </div>
  </div>
</aside>
