---
import Icon from "./icon.astro";

const navItems = [
  { href: "#about", en: "About", es: "Sobre mí" },
  { href: "#projects", en: "Projects", es: "Proyectos" },
  { href: "#game-development", en: "Games", es: "Juegos" },
  { href: "#experience", en: "Experience", es: "Experiencia" },
  { href: "#skills", en: "Skills", es: "Habilidades" },
  { href: "#contact", en: "Contact", es: "Contacto" },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0f172a]/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center h-16 w-full gap-6">
      <a href="#about" class="flex items-center gap-3 group" aria-label="Jonathan Dorado, home">
        <div class="w-12 h-12 flex items-center justify-center rounded-[15px] bg-[#253252] group-hover:scale-105 transition duration-300">
          <Icon name="Logo" class="w-7 h-7" />
        </div>
      </a>

      <nav class="hidden lg:flex flex-1 justify-center" aria-label="Main">
        <ul class="flex items-center gap-7">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link relative py-2 text-gray-300 hover:text-cyan-400 aria-[current=true]:text-cyan-400 whitespace-nowrap
                after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:w-full after:rounded-full after:bg-cyan-400
                after:origin-left after:scale-x-0 after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=true]:after:scale-x-100"
                data-en={item.en}
                data-es={item.es}
                >
                {item.en}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-3 ml-auto">

        <a
          href="/cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden xl:inline-flex items-center gap-2 h-10 px-4 rounded-lg bg-cyan-400/10 border border-cyan-400/30 text-cyan-300 text-sm hover:bg-cyan-400/20"
        >
          <Icon name="download" class="w-4 h-4" />
          <span data-en="CV" data-es="CV">CV</span>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-slate-700 text-gray-200 flex items-center justify-center"
          aria-label="Toggle theme"
          >
          <Icon name="sun" class="w-5 h-5 dark:hidden" />
          <Icon name="moon" class="w-5 h-5 hidden dark:block" />
        </button>

        <button
          type="button"
          class="lang-toggle hidden sm:inline-flex items-center h-10 bg-slate-800 hover:bg-slate-700 text-gray-200 border border-slate-700 rounded-lg px-3 text-sm"
          data-en="🇬🇧 EN"
          data-es="🇪🇸 ES"
          aria-label="Cambiar a español"
          >
          🇬🇧 EN
        </button>

        <button
          id="menu-btn"
          type="button"
          class="lg:hidden w-10 h-10 flex items-center justify-center bg-slate-800 hover:bg-slate-700 rounded-lg text-white"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          >
          <Icon name="menu" class="w-5 h-5" />
        </button>

      </div>
    </div>
  </div>
</header>

<div
  id="overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-60 opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<aside
  id="mobile-menu"
  class="fixed top-0 right-0 h-dvh w-80 max-w-[85vw] bg-[#0f172a]/95 backdrop-blur-xl border-l border-white/10 shadow-2xl
  transform translate-x-full transition-transform duration-300 ease-out z-70"
  aria-label="Mobile menu"
  inert
>
  <div class="h-full flex flex-col p-6">

    <div class="flex justify-between items-center mb-10">
      <span class="text-gray-200 font-semibold" data-en="Menu" data-es="Menú">Menu</span>
      <button
        id="close-menu"
        type="button"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-white hover:bg-white/10"
        aria-label="Close menu"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    </div>

    <nav class="flex-1" aria-label="Mobile">
      <ul class="flex flex-col gap-2">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link block px-3 py-2.5 rounded-lg text-gray-300 text-lg hover:text-cyan-400 hover:bg-white/5 hover:translate-x-1 aria-[current=true]:text-cyan-400"
              data-en={item.en}
              data-es={item.es}
            >
              {item.en}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="pt-6 border-t border-white/10 flex flex-col gap-3">
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full py-2.5 rounded-lg bg-cyan-400/10 border border-cyan-400/30 text-cyan-300 text-sm hover:bg-cyan-400/20"
      >
        <Icon name="download" class="w-4 h-4" />
        <span data-en="Download CV" data-es="Descargar CV">Download CV</span>
      </a>

      <button
        type="button"
        class="lang-toggle w-full bg-slate-800 hover:bg-slate-700 text-gray-200 border border-slate-700 rounded-lg px-3 py-2.5 text-sm"
        data-en="🇬🇧 EN"
        data-es="🇪🇸 ES"
        aria-label="Cambiar a español"
      >
        🇬🇧 EN
      </button>
    </div>
  </div>
</aside>
