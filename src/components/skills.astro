---
import Icon from "./icon.astro";
import Sectionheading from "./sectionheading.astro";
import { techLinks } from "../data/tech.ts";

const skillGroups = [
  {
    title: { en: "Frontend & Mobile", es: "Frontend y Móvil" },
    skills: ["Angular", "Astro", "React", "TypeScript", "JavaScript", "HTML", "CSS", "Tailwind CSS", "Vite", "Flutter", "Dart", "Kotlin", "Android Studio"],
  },
  {
    title: { en: "Backend", es: "Backend" },
    skills: ["Django", "Python", "Node.js", "PHP", "Java", "Supabase", "Odoo", "WebRTC"],
  },
  {
    title: { en: "Databases", es: "Bases de datos" },
    skills: ["PostgreSQL", "MySQL", "SQL Server", "MongoDB", "SQLite"],
  },
  {
    title: { en: "DevOps & Tools", es: "DevOps y Herramientas" },
    skills: ["Git", "GitHub", "GitHub Actions", "Docker", "Linux", "Vercel", "PNPM", "VS Code"],
  },
  {
    title: { en: "Game Development", es: "Videojuegos" },
    skills: ["Unity", "Godot", "C#"],
  },
];

const softSkills = [
  { en: "Teamwork", es: "Trabajo en equipo" },
  { en: "Communication", es: "Comunicación" },
  { en: "Problem solving", es: "Resolución de problemas" },
  { en: "Self-learning", es: "Aprendizaje autónomo" },
  { en: "Adaptability", es: "Adaptabilidad" },
  { en: "Time management", es: "Gestión del tiempo" },
  { en: "Critical thinking", es: "Pensamiento crítico" },
  { en: "Attention to detail", es: "Atención al detalle" },
];

const languages = [
  { en: "Spanish · Native", es: "Español · Nativo" },
  { en: "English · A2", es: "Inglés · A2" },
];

const row = "grid md:grid-cols-[200px_1fr] gap-x-8 gap-y-3 py-3.5 md:py-4 first:pt-0 last:pb-0";
const label = "text-sm font-semibold text-(--text-primary) md:pt-1.5";
const chip = "inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-(--bg-card) border border-(--text-primary)/8 text-xs md:text-[13px] font-medium text-(--text-primary)";
---

<section id="skills" class="relative px-5 sm:px-6 pt-12 md:pt-16 pb-16 md:pb-24">
  <div class="max-w-7xl mx-auto w-full">

    <Sectionheading title={{ en: "Skills", es: "Habilidades" }} />

    <!-- Una sola ficha: una fila por categoría -->
    <div data-reveal class="rounded-[12px] border border-(--text-primary)/10 bg-(--bg-secondary) p-5 md:p-8">
      {skillGroups.map((group) => (
        <div class={row}>
          <h3 class={label} data-en={group.title.en} data-es={group.title.es}>{group.title.en}</h3>
          <ul class="flex flex-wrap gap-1.5">
            {group.skills.map((skill) => (
              <li>
                <a
                  href={techLinks[skill]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`group/skill ${chip} hover:border-(--accent)/40 hover:-translate-y-0.5`}
                >
                  <Icon name={skill} class="w-4 h-4 group-hover/skill:scale-110 transition duration-300" />
                  {skill}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class={row}>
        <h3 class={label} data-en="Soft skills" data-es="Habilidades blandas">Soft skills</h3>
        <ul class="flex flex-wrap gap-1.5">
          {softSkills.map((skill) => (
            <li class={chip}>
              <span data-en={skill.en} data-es={skill.es}>{skill.en}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class={row}>
        <h3 class={label} data-en="Languages" data-es="Idiomas">Languages</h3>
        <ul class="flex flex-wrap gap-1.5">
          {languages.map((language) => (
            <li class={chip}>
              <span data-en={language.en} data-es={language.es}>{language.en}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
