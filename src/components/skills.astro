---
const skillGroups = [
  {
    title: {
      en: "Frontend",
      es: "Frontend",
    },
    skills: [
      "Angular",
      "Astro",
      "TypeScript",
      "JavaScript",
      "HTML",
      "CSS",
      "Tailwind CSS",
      "Vite",
      "Responsive Design",
      "UI/UX Principles",
    ],
  },
  {
    title: {
      en: "Backend",
      es: "Backend",
    },
    skills: [
      "Django",
      "Python",
      "Node.js",
      "REST APIs",
      "WebSockets",
      "Authentication & Authorization",
      "Real-time systems",
    ],
  },
  {
    title: {
      en: "Database",
      es: "Base de datos",
    },
    skills: [
      "PostgreSQL",
      "MySQL",
      "SQLite",
      "Database Design",
      "Data Modeling",
    ],
  },
  {
    title: {
      en: "DevOps & Tools",
      es: "DevOps y Herramientas",
    },
    skills: [
      "Git",
      "GitHub",
      "GitHub Actions",
      "Docker",
      "Linux",
      "Vercel",
      "PNPM",
      "VS Code",
      "CI/CD basics",
    ],
  },
  {
    title: {
      en: "Game Development",
      es: "Desarrollo de videojuegos",
    },
    skills: [
      "Unity",
      "C#",
      "Gameplay Systems",
      "Input Systems",
      "Prototyping",
      "Game Feel",
    ],
  },
  {
    title: {
      en: "Networking & Real-time",
      es: "Redes y tiempo real",
    },
    skills: [
      "WebSockets",
      "WebRTC",
      "Multiplayer Architecture",
      "Client-Server Sync",
    ],
  },
];
---

<section id="skills" class="min-h-screen flex items-center px-6 py-20 scroll-mt-24">
  <div class="max-w-7xl mx-auto w-full">

    <div class="mb-20">
      <h2 class="text-5xl md:text-6xl font-bold max-w-4xl">
        <span data-en="Skills" data-es="Habilidades">
          Habilidades
        </span>{" "}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {skillGroups.map((group) => (
        <div class="group rounded-3xl border border-(--border) bg-white/2 p-8 transition-all duration-300 hover:border-(--accent)/40">

          <h3
            class="text-2xl font-semibold mb-8"
            data-en={group.title.en}
            data-es={group.title.es}
          >
            {group.title.en}
          </h3>

          <div class="flex flex-wrap gap-3">
            {group.skills.map((skill) => (
              <span class="px-4 py-2 rounded-xl bg-white/3 border border-(--border) text-(--text-secondary) transition-all duration-300 hover:border-(--accent)/30 hover:text-white">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>