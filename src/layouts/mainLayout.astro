---
import Hero from '../components/hero.astro';
import Header from '../components/header.astro';
import Projects from '../components/projects.astro';
import Gamedevelopment from '../components/gamedevelopment.astro';
import Experience from '../components/experience.astro';
import Skills from '../components/skills.astro';
import Footer from '../components/footer.astro';
import Iconsprite from '../components/iconsprite.astro';
import "../styles/global.css";

const title = "Jonathan Dorado | Full Stack & Game Developer";
const description = "Portfolio of Jonathan Dorado, Full Stack Developer and Game Developer. Web, mobile and multiplayer projects built with Astro, Angular, React, Flutter, Django and Unity.";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Jonathan Dorado" />
		<meta name="theme-color" content="#0f172a" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href="/fonts/Lexend-Medium.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Lexend-Bold.woff2" as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />

		<script>
			import "../scripts/main.ts";
		</script>
		
		<script is:inline>
			const savedTheme = localStorage.getItem("theme");
			const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
			const theme = savedTheme ?? (systemDark ? "dark" : "light");
			document.documentElement.classList.toggle("dark", theme === "dark");

			const savedLang = localStorage.getItem("language");
			const browserLang = navigator.language.toLowerCase();
			const lang = savedLang ?? (browserLang.startsWith("es") ? "es" : "en");
			document.documentElement.setAttribute("data-lang", lang);
			document.documentElement.lang = lang;
		</script>
	</head>

	<body>
		<Iconsprite />
		<Header></Header>
		<main>
			<Hero></Hero>
			<Projects></Projects>
			<Gamedevelopment></Gamedevelopment>
			<Experience></Experience>
			<Skills></Skills>
		</main>
		<Footer></Footer>
	</body>
</html>
