---
const particles = Array.from({ length: 24 });
const stars = Array.from({ length: 40 });
---

<section id="hero" class="relative min-h-screen flex items-center justify-center px-6 overflow-hidden">

  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[700px] opacity-40 blur-3xl"
    style="
      background:
      radial-gradient(circle at 30% 50%, rgba(99,102,241,.25), transparent 30%),
      radial-gradient(circle at 70% 40%, rgba(6,182,212,.18), transparent 30%),
      radial-gradient(circle at 50% 80%, rgba(168,85,247,.15), transparent 35%);
      animation: aurora 14s ease-in-out infinite;
    "
  />

  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full border border-white/[0.04] opacity-60" style="animation:ringPulse 8s ease-in-out infinite;"/>

  <div class="absolute inset-0 pointer-events-none">
    {
      stars.map(() => (
        <span class="absolute rounded-full bg-white"
          style={`
            width:${Math.random() * 3 + 1}px;
            height:${Math.random() * 3 + 1}px;
            left:${Math.random() * 100}%;
            top:${Math.random() * 100}%;
            opacity:${Math.random() * .6};
            animation: twinkle ${Math.random() * 5 + 3}s infinite;
          `}
        />
      ))
    }
  </div>

  <div class="absolute inset-0 pointer-events-none">
    {
      particles.map(() => (
        <span class="absolute rounded-full bg-white/20"
          style={`
            width:${Math.random() * 6 + 2}px;
            height:${Math.random() * 6 + 2}px;
            left:${Math.random() * 100}%;
            top:${Math.random() * 100}%;
            animation:
              drift ${Math.random() * 18 + 12}s linear infinite;
          `}
        />
      ))
    }
  </div>

  <div class="relative z-10 max-w-4xl text-center">

    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-xl">
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      <span class="text-xs tracking-[0.2em] uppercase text-white/60">
        Available for work
      </span>
    </div>

    <h1 class="mt-8 text-5xl md:text-7xl lg:text-8xl font-semibold tracking-tight text-white leading-[0.95]">
      Jonathan Dorado Quintero
    </h1>

    <div class="mt-8 space-y-4 max-w-3xl mx-auto">

      <p class="text-lg md:text-xl text-(--text-secondary) leading-relaxed">
        Full Stack Developer passionate about creating modern web applications
        and interactive experiences.
      </p>

      <p class="text-base md:text-lg text-(--text-secondary)">
        I enjoy working with
        <span class="text-white font-medium"> Angular</span>,
        <span class="text-white font-medium"> Astro</span>,
        <span class="text-white font-medium"> Django</span>,
        <span class="text-white font-medium"> Unity</span>
        and exploring new technologies.
      </p>

      <p class="text-base md:text-lg text-(--text-secondary)">
        Currently focused on building scalable applications,
        game development projects and elegant user interfaces.
      </p>

    </div>

    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">

      <a href="#projects" class="px-7 py-3 rounded-xl bg-(--accent) text-black font-medium hover:scale-[1.03] transition">
        View Projects
      </a>

      <a href="#contact" class="px-7 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xl hover:bg-white/10 transition">
        Contact Me
      </a>
    </div>
  </div>
</section>

<style>
@keyframes aurora {
  0%,100% {
    transform: translateX(0) translateY(0) rotate(0deg);
  }

  50% {
    transform: translateX(40px) translateY(-20px) rotate(4deg);
  }
}

@keyframes ringPulse {
  0%,100% {
    transform:
      translate(-50%, -50%)
      scale(1);
    opacity: .25;
  }

  50% {
    transform:
      translate(-50%, -50%)
      scale(1.08);
    opacity: .5;
  }
}

@keyframes drift {
  from {
    transform: translate(0,0);
  }

  25% {
    transform: translate(40px,-30px);
  }

  50% {
    transform: translate(-20px,-80px);
  }

  75% {
    transform: translate(-50px,-20px);
  }

  to {
    transform: translate(0,0);
  }
}

@keyframes twinkle {
  0%,100% {
    opacity:.2;
  }

  50% {
    opacity:1;
  }
}
</style>