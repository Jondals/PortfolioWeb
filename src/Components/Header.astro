---
const navItems = [
  { name: "About Me", href: "#about" },
  { name: "Projects", href: "#projects" },
  { name: "Experience", href: "#experience" },
];
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-[#0f172a]/80 backdrop-blur-md border-b border-white/10"
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="#" class="text-xl font-bold text-white hover:text-cyan-400 transition-colors "></a>

      <!-- Navigation -->
      <nav>
        <ul class="flex items-center gap-8">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="text-gray-300 hover:text-cyan-400 transition-colors duration-200 font-medium"> {item.name}</a>
            </li>
          ))}
        </ul>
      </nav>

    </div>
  </div>
</header>